       "                lhs\\_group{[}{[}i{]}{]} = which(lhs\\_group\\_id == i)\n",
       "            \\}\n",
       "        \\}\n",
       "        else if (do\\_multi\\_lhs == FALSE) \\{\n",
       "            lhs\\_group\\_is\\_na = list(FALSE)\n",
       "            lhs\\_group\\_n\\_na = 0\n",
       "            lhs\\_group = list(1)\n",
       "            lhs = list(lhs)\n",
       "            names(lhs) = deparse\\_long(fml{[}{[}2{]}{]})\n",
       "        \\}\n",
