       "    if (fromGLM) \\{\n",
       "        res\\$fitted.values = y - res\\$residuals\n",
       "        if (!onlyFixef) \\{\n",
       "            res\\$X\\_demean = X\\_demean\n",
       "        \\}\n",
       "        return(res)\n",
       "    \\}\n",
       "    collin.adj = 0\n",
       "    if (res\\$multicol) \\{\n",
       "        var\\_collinear = RHS\\_names{[}est\\$is\\_excluded{]}\n",
