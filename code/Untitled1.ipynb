       "    if (isWeight) \n",
       "        res\\$weights = weights\n",
       "    resid\\_origin = NULL\n",
       "    if (!is.null(dots\\$resid\\_1st\\_stage)) \\{\n",
       "        is\\_int = \"(Intercept)\" \\%in\\% names(res\\$coefficients)\n",
       "        resid\\_origin = res\\$residuals\n",
       "        resid\\_new = cpp\\_iv\\_resid(res\\$residuals, res\\$coefficients, \n",
       "            dots\\$resid\\_1st\\_stage, is\\_int, nthreads)\n",
       "        res\\$iv\\_residuals = res\\$residuals\n",
       "        res\\$residuals = resid\\_new\n",
       "    \\}\n",
       "    if (onlyFixef) \\{\n",
       "        res\\$fitted.values = res\\$sumFE = y - res\\$residuals\n",
       "    \\}\n",
       "    else \\{\n",
       "        if (mem.clean) \\{\n",
       "            gc()\n",
       "        \\}\n",
       "        if (isFixef) \\{\n",
       "            x\\_beta = cpp\\_xbeta(X, coef, nthreads)\n",
       "            if (!is.null(resid\\_origin)) \\{\n",
       "                res\\$sumFE = y - x\\_beta - resid\\_origin\n",
       "            \\}\n",
       "            else \\{\n",
       "                res\\$sumFE = y - x\\_beta - res\\$residuals\n",
       "            \\}\n",
