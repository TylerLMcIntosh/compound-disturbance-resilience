       "            X\\_demean = matrix(1, nrow = length(y\\_demean))\n",
       "        \\}\n",
       "        else \\{\n",
       "            X\\_demean = vars\\_demean\\$X\\_demean\n",
       "        \\}\n",
       "        res\\$iterations = vars\\_demean\\$iterations\n",
