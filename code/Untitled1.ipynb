       "    \\}\n",
       "    else \\{\n",
       "        res\\$residuals = y\\_demean\n",
       "        res\\$coefficients = coef = NULL\n",
       "        res\\$onlyFixef = TRUE\n",
       "        res\\$multicol = FALSE\n",
       "        if (demeaned) \\{\n",
       "            res\\$y\\_demeaned = y\\_demean\n",
       "        \\}\n",
       "    \\}\n",
       "    time\\_post = proc.time()\n",
       "    if (verbose >= 1) \\{\n",
       "        show\\_timing(\"Estimation\")\n",
       "    \\}\n",
