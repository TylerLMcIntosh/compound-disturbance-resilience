       "<span style=white-space:pre-wrap>            gc()</span>\n",
       "<span style=white-space:pre-wrap>        }</span>\n",
       "<span style=white-space:pre-wrap>        res$sigma2 = cpp_ssq(res$residuals, weights)/(length(y) - </span>\n",
