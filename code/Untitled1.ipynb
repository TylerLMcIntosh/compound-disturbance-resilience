      "text/latex": [
       "\\begin{minted}{r}\n",
       "function (fml, data, vcov, weights, offset, subset, split, fsplit, \n",
       "    split.keep, split.drop, cluster, se, ssc, panel.id, panel.time.step = NULL, \n",
