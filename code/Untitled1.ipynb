       "        res\\$sq.cor = tryCatch(stats::cor(y, res\\$fitted.values), \n",
       "            warning = function(x) NA\\_real\\_)\\textasciicircum{}2\n",
       "    \\}\n",
       "    else \\{\n",
       "        res\\$sq.cor = NA\n",
       "    \\}\n",
       "    if (mem.clean) \\{\n",
