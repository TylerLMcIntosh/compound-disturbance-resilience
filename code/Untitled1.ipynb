       "            all\\_vars = RHS\\_names\n",
       "            if (isFixef) \\{\n",
       "                msg = sma(\"\\{\\$(The only variable;All variables)\\}, \\{enum.q.3 ? all\\_vars\\}, \\{\\$are\\} collinear with the fixed effects. Without doubt, your model is misspecified.\")\n",
       "            \\}\n",
       "            else \\{\n",
       "                msg = sma(\"\\{\\$(The only variable;All variables)\\}, \\{enum.q.3 ? all\\_vars\\}, \\{\\$are\\} virtually constant and equal to 0. Without doubt, your model is misspecified.\")\n",
       "            \\}\n",
