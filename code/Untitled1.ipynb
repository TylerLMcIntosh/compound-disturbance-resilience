       "<span style=white-space:pre-wrap>            }</span>\n",
       "<span style=white-space:pre-wrap>            rhs_group = list()</span>\n",
       "<span style=white-space:pre-wrap>            for (i in 1:max(rhs_group_id)) {</span>\n",
