       "        res = multi\\_fixef(env, feols)\n",
       "        return(res)\n",
       "    \\}\n",
       "    do\\_multi\\_lhs = get(\"do\\_multi\\_lhs\", env)\n",
       "    do\\_multi\\_rhs = get(\"do\\_multi\\_rhs\", env)\n",
       "    if (do\\_multi\\_lhs \\textbar{}\\textbar{} do\\_multi\\_rhs) \\{\n",
       "        assign(\"do\\_multi\\_lhs\", FALSE, env)\n",
       "        assign(\"do\\_multi\\_rhs\", FALSE, env)\n",
       "        do\\_iv = get(\"do\\_iv\", env)\n",
       "        fml = get(\"fml\", env)\n",
       "        lhs\\_names = get(\"lhs\\_names\", env)\n",
       "        lhs = y\n",
       "        if (do\\_multi\\_lhs) \\{\n",
       "            n\\_lhs = length(lhs)\n",
       "            lhs\\_group\\_is\\_na = list()\n",
       "            lhs\\_group\\_id = c()\n",
       "            lhs\\_group\\_n\\_na = c()\n",
       "            for (i in 1:n\\_lhs) \\{\n",
       "                is\\_na\\_current = !is.finite(lhs{[}{[}i{]}{]})\n",
       "                n\\_na\\_current = sum(is\\_na\\_current)\n",
       "                if (all(is\\_na\\_current)) \\{\n",
       "                  msg = sma(\"The dep.var. \\{bq ? lhs\\_names{[}i{]}\\} contains only NAs.\")\n",
       "                  stack\\_multi\\_notes(msg)\n",
       "                \\}\n",
       "                if (i == 1) \\{\n",
       "                  lhs\\_group\\_id = 1\n",
       "                  lhs\\_group\\_is\\_na{[}{[}1{]}{]} = is\\_na\\_current\n",
       "                  lhs\\_group\\_n\\_na{[}1{]} = n\\_na\\_current\n",
       "                \\}\n",
       "                else \\{\n",
       "                  qui = which(lhs\\_group\\_n\\_na == n\\_na\\_current)\n",
       "                  if (length(qui) > 0) \\{\n",
       "                    if (n\\_na\\_current == 0) \\{\n",
       "                      lhs\\_group\\_id{[}i{]} = lhs\\_group\\_id{[}qui{[}1{]}{]}\n",
       "                      next\n",
       "                    \\}\n",
       "                    for (j in qui) \\{\n",
       "                      if (all(is\\_na\\_current == lhs\\_group\\_is\\_na{[}{[}j{]}{]})) \\{\n",
       "                        lhs\\_group\\_id{[}i{]} = lhs\\_group\\_id{[}j{]}\n",
       "                        next\n",
       "                      \\}\n",
       "                    \\}\n",
       "                  \\}\n",
       "                  id = max(lhs\\_group\\_id) + 1\n",
       "                  lhs\\_group\\_id{[}i{]} = id\n",
       "                  lhs\\_group\\_is\\_na{[}{[}id{]}{]} = is\\_na\\_current\n",
       "                  lhs\\_group\\_n\\_na{[}id{]} = n\\_na\\_current\n",
